# LDAP 管理员 Web 站点 — 配置模板（复制为 ldap_admin_web.env 填写真实值）
# 该模板可提交仓库；真实值文件 ldap_admin_web.env 已被 .gitignore 忽略。

# ── Web 服务 ──
WEB_LISTEN=127.0.0.1
WEB_PORT=8080

# ── 管理员登录（与 LDAP 账号分离，请使用强密码）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
SESSION_TIMEOUT=28800

# ── LDAP 连接（Manager 凭据仅存服务端）──
LDAP_HOST=ldap01.example.com
LDAP_PORT=636
LDAP_SUFFIX=dc=example,dc=com
LDAP_MANAGER_DN=cn=Manager,dc=example,dc=com
# 方式一：明文密码（简单，600 权限）
LDAP_MANAGER_PW=change-me-manager-password
# 方式二：从密码文件读取（推荐，避免明文落盘两份；设置后优先于 LDAP_MANAGER_PW）
#LDAP_MANAGER_PW_FILE=/root/ldap/.passwdfile_manager
LDAP_TLS_CACERT=/etc/openldap/certs/ca.crt

# ── LDAP 目录结构 ──
LDAP_USER_BASE=ou=People,dc=example,dc=com
LDAP_GROUP_BASE=ou=Group,dc=example,dc=com
LDAP_SUDO_BASE=ou=sudoers,dc=example,dc=com
LDAP_AUTOMOUNT_BASE=nisMapName=auto.nfs,ou=automapper,dc=example,dc=com

# ── 创建用户默认值 ──
DEFAULT_SHELL=/bin/csh
DEFAULT_HOME_BASE=/share/home
MAIL_DOMAIN=example.com
UID_MIN=5000

# ── 密码策略默认值 ──
SHADOW_MAX_DAYS=90
SHADOW_WARN_DAYS=7
SHADOW_INACTIVE=30
